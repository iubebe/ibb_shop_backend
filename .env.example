PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ibb_redis_password
REDIS_DB=0

LOG_LEVEL=debug
LOG_PRETTY=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=ibb
DB_PASSWORD=ibb_password
DB_NAME=ibb
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# Auth: secrets must be >= 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
CSRF_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Seed (pnpm db:seed). Leave SEED_ADMIN_PASSWORD empty to generate one.
SEED_ADMIN_EMAIL=admin@ibb.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=
SEED_BRANCH_NAME=Main Branch

# Throttling (per client IP, Redis backed). TRUST_PROXY = reverse proxies in front.
THROTTLE_ENABLED=true
TRUST_PROXY=0
THROTTLE_BURST_LIMIT=50
THROTTLE_LIMIT=600
THROTTLE_TTL=60
THROTTLE_BLOCK_SECONDS=60
THROTTLE_STRICT_LIMIT=10
THROTTLE_STRICT_TTL=60
THROTTLE_STRICT_BLOCK_SECONDS=60
WS_CONNECT_LIMIT=30

# Timezone that defines "today" on the dashboard (IANA name)
SHOP_TIMEZONE=Asia/Ho_Chi_Minh

# S3 / RustFS (product images, QR codes). Public URL = how browsers reach objects.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ibb_rustfs
S3_SECRET_KEY=ibb_rustfs_secret
S3_BUCKET=ibb-media
S3_PUBLIC_URL=

# Guest web origin encoded in printed table QR codes (…/t/{qrToken})
GUEST_APP_URL=http://localhost:5176

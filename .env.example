PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ibb_redis_password
REDIS_DB=0

LOG_LEVEL=debug
LOG_PRETTY=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=ibb
DB_PASSWORD=ibb_password
DB_NAME=ibb
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# Auth: secrets must be >= 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
CSRF_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Seed (pnpm db:seed). Leave SEED_ADMIN_PASSWORD empty to generate one.
SEED_ADMIN_EMAIL=admin@ibb.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=
SEED_BRANCH_NAME=Main Branch
